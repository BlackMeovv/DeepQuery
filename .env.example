# ============================================================
# deepquery 环境配置
# 复制为 .env 并填入你的 API 信息：  cp .env.example .env
# 任何 OpenAI 兼容接口都可以（DeepSeek / Qwen(DashScope) / Kimi /
# OpenAI / OpenRouter / 本地 vLLM/Ollama ...）
# ============================================================

# --- LLM 接入（必填）---
# API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# OpenAI 兼容的 base_url：
#   DeepSeek:            https://api.deepseek.com/v1
#   Qwen (DashScope):    https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi (Moonshot):     https://api.moonshot.cn/v1
#   OpenAI:              https://api.openai.com/v1
#   本地 Ollama:         http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名（与 base_url 对应），如 deepseek-chat / qwen-plus / kimi-k2-turbo-preview
LLM_MODEL=deepseek-chat

# --- 成本记账（选填，单位：每百万 token 的价格，币种自定，只用于统计）---
# 默认按 DeepSeek-chat 价格占位；换模型请同步更新，报告里的成本才准确
LLM_PRICE_INPUT_PER_M=0.27
LLM_PRICE_OUTPUT_PER_M=1.10

# --- 采样与超时（选填）---
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Agent 行为（选填）---
# 自纠错最大轮数（超过则降级收尾）
AGENT_MAX_REPAIR_ROUNDS=3
# 单次提问的预算熔断：token 上限与金额上限（0 表示不限制）
AGENT_MAX_TOKENS_PER_RUN=200000
AGENT_MAX_COST_PER_RUN=0.05

# --- 表结构怎么交给模型（选填）---
# auto=装得下就全量直供，装不下走渐进式披露（默认）/ off=全量直供 / on=检索选表
# disclose=渐进式披露：先只给表目录（表名 + 说明 + 列名），模型选表后再展开完整定义、按需查列的真实取值；
#          多一次模型调用，想在小库上演示这个流程时可以打开
#SCHEMA_RAG=auto
#SCHEMA_RAG_TOP_K=6
# auto 的分界（全量 schema 字符数）：装得下就直供——BIRD 消融中直供不低于检索选表，还少一个召回失败点
#SCHEMA_RAG_AUTO_MAX_CHARS=16000
#SCHEMA_DISCLOSE_MAX_TABLES=8
# 查询没查到数据（空结果，或 COUNT/SUM 得 0 而过滤值在库里不存在）时，查出过滤列的真实取值交给修复轮
#REPAIR_VALUE_PROBE=true
# 多候选投票（1 = 关闭）：设成 3 时先多采样一条 SQL，两条执行结果一致就采用；不一致再补一条，按结果多数决。
# 每题多 1–2 次模型调用，适合评测对照或对准确率要求高的场景
#SQL_CANDIDATES=1
#SQL_VOTE_TEMPERATURE=0.7

# --- 深度分析（选填）---
# 一次分析：先拆几步、最多几步（含看完结果追加的下钻），预算是单次提问（AGENT_MAX_*_PER_RUN）的几倍
#ANALYSIS_PLAN_STEPS=4
#ANALYSIS_MAX_STEPS=6
#ANALYSIS_BUDGET_FACTOR=4
# 业务字典与 few-shot 例句（jsonl，路径不存在则自动跳过）。
# 不改时跟随数据集：用 Olist 库会自动换成 eval/knowledge/olist/ 下的口径
#GLOSSARY_PATH=eval/knowledge/glossary.jsonl
#EXAMPLES_PATH=eval/knowledge/examples.jsonl

# --- 向量检索（选填；不配置则纯 BM25，功能完整）---
# 任何 OpenAI 兼容 embeddings 接口，如 DashScope: text-embedding-v3
#EMBED_API_KEY=sk-xxxx
#EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#EMBED_MODEL=text-embedding-v3

# --- 回答防幻觉校验（选填，默认开启）---
# 回答中的数字必须在查询结果/问题/SQL 里有出处，否则重写一次，仍失败则降级
#ANSWER_VERIFY=true

# --- SQL 守卫（选填）---
# 单条 SQL 执行超时（秒）与返回行数上限
SQL_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=200
# 表级权限：配置后 Agent 只能看见/查询这些表（逗号分隔），schema 注入、
# 守卫白名单、前端库表树、MCP 工具同步过滤；不配置 = 全部表可见。
# 多角色部署按角色起实例配不同值——权限硬边界仍在数据库只读账号的 GRANT
#ALLOWED_TABLES=orders,products

# --- 数据库（选填）---
# 三种接入方式（schema 运行时自省，agent 与库解耦；CLI 可用 --db 临时切换）：
#   SQLite 文件:  data/demo/ecommerce.sqlite（默认，程序生成的虚构电商数据，make demo-db）
#                data/olist/olist.sqlite（Olist 巴西电商真实数据，约 10 万订单，make olist-db；
#                Docker 部署时首次启动自动下载导入）
#   MySQL:       mysql://readonly:pwd@host:3306/dbname   （uv sync --extra mysql）
#   PostgreSQL:  postgres://readonly:pwd@host:5432/dbname（uv sync --extra postgres）
# ⚠️ 服务器引擎务必用只读账号连接——权限硬边界在数据库账号，不在应用代码
DB_PATH=data/demo/ecommerce.sqlite

# --- 图表沙箱（选填）---
# docker=宿主机 Docker 隔离（生产）/ subprocess=子进程限额（开发或容器内）/ auto
#CHART_EXECUTOR=auto
#CHART_TIMEOUT_SECONDS=20
#CHART_OUT_DIR=data/charts

# --- 服务（选填）---
#SERVER_HOST=0.0.0.0
#SERVER_PORT=8000
# 公网演示部署的访问口令：配置后 /api/ask 与记忆读写需携带 ?code=口令
# （前端会弹窗询问并记住），并且每个浏览器的记忆相互隔离。不配置 = 不设防，仅建议内网/本机使用
#DEMO_ACCESS_CODE=
# 公网演示的费用防线（0 = 关闭）：每个访客每分钟最多提问次数；全站每日模型花费上限
# （与上面 LLM_PRICE_* 同币种；用完后已问过的问题仍可从缓存查看）
#RATE_LIMIT_PER_MINUTE=6
#DAILY_COST_LIMIT=2
# 全站同时运行的提问数上限（默认 4）；浏览器断开时正在运行的提问会立即停止，不再继续花钱
#MAX_CONCURRENT_RUNS=4
# 部署在 nginx 后面时开启，用 X-Real-IP 区分访客（应用端口只对本机开放时才安全）
#TRUST_PROXY_HEADERS=true
# docker compose 发布应用端口的地址：默认只对本机开放、由 nginx 转发；
# 没有 nginx、临时想用 服务器IP:8000 直接访问时改成 0.0.0.0
#APP_BIND=127.0.0.1
# 网页首页展示的数据说明（告诉访客这份数据是什么、能问什么）；
# 不配置时：用演示库则自动显示内置说明，用自己的库则不显示
#DATASET_NOTE=
#GRAFANA_ADMIN_PASSWORD=

# --- 镜像构建（选填，国内服务器用）---
# 拉不到 ghcr.io / Docker Hub / npm 官方源时，换成能访问的镜像地址；不填用官方默认值
#UV_IMAGE=ghcr.io/astral-sh/uv:python3.11-bookworm-slim
#NODE_IMAGE=node:20-alpine
#NPM_REGISTRY=https://registry.npmmirror.com
# 结果缓存：配置 Redis 则多实例共享（需 uv sync --extra cache），否则进程内 LRU
# 数据时效：TTL 是数据变动后旧答案存活的上限；前端「重跑」强制绕过缓存；
# 建/改表会换掉 schema 指纹使旧缓存整体作废（无需重启服务）
#REDIS_URL=redis://localhost:6379/0
#CACHE_TTL_SECONDS=600
# 压测/演示 mock 模式：不调真实 LLM。⚠️ 绝不能用于评测
#LLM_MOCK=0

# --- 跨会话记忆（选填）---
#MEMORY_DB_PATH=data/memory.sqlite

# --- 运行记录与用户反馈（选填）---
# 每次提问记一条（问题、SQL、回答文本、状态、耗时、花费；回答降级为结果预览时预览随回答存下），
# 用户的 👍/👎 挂在对应记录上；
# 留空则不记录，页面上也不显示打分按钮
#RUN_LOG_PATH=data/runs.sqlite
#RUN_LOG_KEEP=20000

# --- Langfuse 追踪（选填）---
# 免费注册 https://cloud.langfuse.com 建一个项目拿到两个 key，
# 再执行 `uv sync --extra trace` 安装 SDK，即可在网页上看每次提问的完整链路。
# 两个 key 缺任何一个则追踪完全关闭（零开销），不影响任何功能。
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_HOST=https://cloud.langfuse.com
