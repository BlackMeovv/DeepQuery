{"id": "followup-01", "category": "followup", "question": "那只看东南部的呢？", "expect": ["sql"], "gold_sql": "SELECT s.name_zh AS 州, COUNT(DISTINCT c.unique_id) AS 客户数 FROM customers c JOIN states s ON s.code = c.state WHERE s.region_zh = '东南部' GROUP BY s.name_zh ORDER BY 客户数 DESC", "history": [{"question": "每个州有多少位客户？", "sql": "SELECT s.name_zh AS 州, COUNT(DISTINCT c.unique_id) AS 客户数 FROM customers c JOIN states s ON s.code = c.state GROUP BY s.name_zh ORDER BY 客户数 DESC"}]}
{"id": "followup-02", "category": "followup", "question": "那 2018 年呢？", "expect": ["sql"], "gold_sql": "SELECT strftime('%Y-%m', purchased_at) AS 月份, COUNT(*) AS 订单数 FROM orders WHERE strftime('%Y', purchased_at) = '2018' GROUP BY 月份 ORDER BY 月份", "history": [{"question": "2017 年每个月有多少笔订单？", "sql": "SELECT strftime('%Y-%m', purchased_at) AS 月份, COUNT(*) AS 订单数 FROM orders WHERE strftime('%Y', purchased_at) = '2017' GROUP BY 月份 ORDER BY 月份"}]}
{"id": "followup-03", "category": "followup", "question": "那最低的 5 个呢？", "expect": ["sql"], "gold_sql": "SELECT c.name_zh AS 品类, ROUND(SUM(oi.price), 2) AS 销售额 FROM order_items oi JOIN orders o ON o.id = oi.order_id JOIN products p ON p.id = oi.product_id JOIN categories c ON c.name = p.category WHERE o.status NOT IN ('canceled', 'unavailable') GROUP BY c.name_zh ORDER BY 销售额 ASC LIMIT 5", "history": [{"question": "销售额最高的 5 个品类是哪些？", "sql": "SELECT c.name_zh AS 品类, ROUND(SUM(oi.price), 2) AS 销售额 FROM order_items oi JOIN orders o ON o.id = oi.order_id JOIN products p ON p.id = oi.product_id JOIN categories c ON c.name = p.category WHERE o.status NOT IN ('canceled', 'unavailable') GROUP BY c.name_zh ORDER BY 销售额 DESC LIMIT 5"}]}
