# bird 子集：150/1534 条（seed=42），gold 已逐条执行校验
# 跑分：python -m deepquery.evalkit.runner --cases eval/cases/bird-dev.jsonl --db-root <BIRD dev 解压目录>
{"id": "bird-13", "question": "Please list the phone numbers of the schools with the top 3 SAT excellence rate.\n（背景知识：Excellence rate = NumGE1500 / NumTstTakr）", "gold_sql": "SELECT T1.Phone FROM schools AS T1 INNER JOIN satscores AS T2 ON T1.CDSCode = T2.cds ORDER BY CAST(T2.NumGE1500 AS REAL) / T2.NumTstTakr DESC LIMIT 3", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-23", "question": "List the names of schools with more than 30 difference in enrollements between K-12 and ages 5-17? Please also give the full street adress of the schools.\n（背景知识：Diffrence in enrollement = `Enrollment (K-12)` - `Enrollment (Ages 5-17)`）", "gold_sql": "SELECT T1.School, T1.Street FROM schools AS T1 INNER JOIN frpm AS T2 ON T1.CDSCode = T2.CDSCode WHERE T2.`Enrollment (K-12)` - T2.`Enrollment (Ages 5-17)` > 30", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-51", "question": "In which mailing street address can you find the school that has the lowest average score in reading? Also give the school's name.", "gold_sql": "SELECT T2.MailStreet, T2.School FROM satscores AS T1 INNER JOIN schools AS T2 ON T1.cds = T2.CDSCode WHERE T1.AvgScrRead IS NOT NULL ORDER BY T1.AvgScrRead ASC LIMIT 1", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-54", "question": "Please specify all of the schools and their related mailing zip codes that are under Avetik Atoian's administration.", "gold_sql": "SELECT School, MailZip FROM schools WHERE AdmFName1 = 'Avetik' AND AdmLName1 = 'Atoian'", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-61", "question": "How many chartered schools located in the city of Hickman are owned by the Elementary School District?\n（背景知识：Elementary School District refers to DOC = 52; Chartered schools refer to Charter = 1 in the table schools）", "gold_sql": "SELECT COUNT(School) FROM schools WHERE DOC = 52 AND Charter = 1 AND City = 'Hickman'", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-65", "question": "What is the ratio in percentage of Santa Clara County schools that are locally funded compared to all other types of charter school funding?\n（背景知识：Ratio in percentage = (count(locally funded schools in Santa Clara) / count(all funding type schools in Santa Clara) * 100%）", "gold_sql": "SELECT CAST(SUM(CASE WHEN FundingType = 'Locally funded' THEN 1 ELSE 0 END) AS REAL) * 100 / SUM(CASE WHEN FundingType != 'Locally funded' THEN 1 ELSE 0 END) FROM schools WHERE County = 'Santa Clara' AND Charter = 1", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-88", "question": "What is the administrator's email address for the school with the highest number of test takers who received SAT scores of at least 1500?Provide the name of the school.", "gold_sql": "SELECT T2.AdmEmail1, T2.School FROM satscores AS T1 INNER JOIN schools AS T2 ON T1.cds = T2.CDSCode ORDER BY T1.NumGE1500 DESC LIMIT 1", "db": "dev_20240627/dev_databases/california_schools/california_schools.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-93", "question": "How many male customers who are living in North Bohemia have average salary greater than 8000?\n（背景知识：Male means that gender = 'M'; A3 refers to region; A11 pertains to average salary.）", "gold_sql": "SELECT COUNT(T1.client_id) FROM client AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id WHERE T1.gender = 'M' AND T2.A3 = 'north Bohemia' AND T2.A11 > 8000", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-96", "question": "How many customers who choose statement of weekly issuance are Owner?\n（背景知识：'POPLATEK TYDNE' stands for weekly issuance）", "gold_sql": "SELECT COUNT(T1.account_id) FROM account AS T1 INNER JOIN disp AS T2 ON T1.account_id = T2.account_id WHERE T2.type = 'OWNER' AND T1.frequency = 'POPLATEK TYDNE'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-114", "question": "For the first client who opened his/her account in Prague, what is his/her account ID?\n（背景知识：A3 stands for region names）", "gold_sql": "SELECT T1.account_id FROM account AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id WHERE T2.A3 = 'Prague' ORDER BY T1.date ASC LIMIT 1", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-130", "question": "How many of the account holders in South Bohemia still do not own credit cards?\n（背景知识：A3 contains the region names; South Bohemia is one of region names.）", "gold_sql": "SELECT COUNT(T3.account_id) FROM district AS T1 INNER JOIN client AS T2 ON T1.district_id = T2.district_id INNER JOIN disp AS T3 ON T2.client_id = T3.client_id WHERE T1.A3 = 'south Bohemia' AND T3.type != 'OWNER'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-135", "question": "After making a credit card withdrawal, how many account/s with monthly issuance has a negative balance?\n（背景知识：Negative balance means balance < 0; Operation = 'VYBER KARTOU' stands for credit card withdraw. Frequency = 'POPLATEK MESICNE' stands for monthly issurance）", "gold_sql": "SELECT COUNT(T1.account_id) FROM trans AS T1 INNER JOIN account AS T2 ON T1.account_id = T2.account_id WHERE T1.balance < 0 AND T1.operation = 'VYBER KARTOU' AND T2.frequency = 'POPLATEK MESICNE'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-142", "question": "Which accounts placed orders for household payment in Pisek?\n（背景知识：k_symbol = 'SIPO' refers to household payment）", "gold_sql": "SELECT DISTINCT T2.account_id FROM trans AS T1 INNER JOIN account AS T2 ON T1.account_id = T2.account_id INNER JOIN district AS T3 ON T2.district_id = T3.district_id WHERE T1.k_symbol = 'SIPO' AND T3.A2 = 'Pisek'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-146", "question": "Who are the female account holders who own credit cards and also have loans?\n（背景知识：Female refers to gender = 'F'）", "gold_sql": "SELECT T1.client_id FROM client AS T1 INNER JOIN disp AS T2 ON T1.client_id = T2.client_id INNER JOIN account AS T5 ON T2.account_id = T5.account_id INNER JOIN loan AS T3 ON T5.account_id = T3.account_id INNER JOIN card AS T4 ON T2.disp_id = T4.disp_id WHERE T1.gender = 'F'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-161", "question": "What type of credit card does the client with the id 13539 own?", "gold_sql": "SELECT T3.type FROM disp AS T1 INNER JOIN client AS T2 ON T1.client_id = T2.client_id INNER JOIN card AS T3 ON T1.disp_id = T3.disp_id WHERE T2.client_id = 13539", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-163", "question": "Which district has the most accounts with loan contracts finished with no problems?\n（背景知识：status = 'A' refers to loan contracts finished with no problems）", "gold_sql": "SELECT T1.A2 FROM District AS T1 INNER JOIN Account AS T2 ON T1.District_id = T2.District_id INNER JOIN Loan AS T3 ON T2.Account_id = T3.Account_id WHERE T3.status = 'A' GROUP BY T1.District_id ORDER BY COUNT(T2.Account_id) DESC LIMIT 1", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-178", "question": "Which kind of credit card does client number 9 possess?", "gold_sql": "SELECT T3.type FROM client AS T1 INNER JOIN disp AS T2 ON T1.client_id = T2.client_id INNER JOIN card AS T3 ON T2.disp_id = T3.disp_id WHERE T1.client_id = 9", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-186", "question": "What percentage of male clients request for weekly statements to be issued?\n（背景知识：Percentage of male clients = [count(male clients who requested weekly statements / count(clients who requested weekly statements)] * 100%; Male means gender = 'M'; 'POPLATEK TYDNE' stands for weekly issuance）", "gold_sql": "SELECT CAST(SUM(T1.gender = 'M') AS REAL) * 100 / COUNT(T1.client_id) FROM client AS T1 INNER JOIN district AS T3 ON T1.district_id = T3.district_id INNER JOIN account AS T2 ON T2.district_id = T3.district_id INNER JOIN disp as T4 on T1.client_id = T4.client_id AND T2.account_id = T4.account_id WHERE T2.frequency = 'POPLATEK TYDNE'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-189", "question": "Name the account numbers of female clients who are oldest and have lowest average salary?\n（背景知识：Female refers to 'F' in the gender; A11 contains information about average salary）", "gold_sql": "SELECT T3.account_id FROM client AS T1 INNER JOIN district AS T2 ON T1.district_id = T2.district_id INNER JOIN account AS T3 ON T2.district_id = T3.district_id INNER JOIN disp AS T4 ON T1.client_id = T4.client_id AND T4.account_id = T3.account_id  WHERE T1.gender = 'F' ORDER BY T1.birth_date ASC, T2.A11 ASC LIMIT 1", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-191", "question": "How many loan accounts are for pre-payment of duration of 24 months with weekly issuance of statement.\n（背景知识：Frequency = 'POPLATEK TYDNE' referes to weekly statement）", "gold_sql": "SELECT COUNT(T2.account_id) FROM account AS T1 INNER JOIN loan AS T2 ON T1.account_id = T2.account_id WHERE T2.duration = 24 AND T1.frequency = 'POPLATEK TYDNE'", "db": "dev_20240627/dev_databases/financial/financial.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-198", "question": "On average how many carcinogenic molecules are single bonded?\n（背景知识：carcinogenic molecules refers to label = '+'; single-bonded refers to bond_type = '-'; average = DIVIDE(SUM(bond_type = '-'), COUNT(atom_id))）", "gold_sql": "SELECT AVG(single_bond_count) FROM (SELECT T3.molecule_id, COUNT(T1.bond_type) AS single_bond_count FROM bond AS T1  INNER JOIN atom AS T2 ON T1.molecule_id = T2.molecule_id INNER JOIN molecule AS T3 ON T3.molecule_id = T2.molecule_id WHERE T1.bond_type = '-' AND T3.label = '+' GROUP BY T3.molecule_id) AS subquery", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-206", "question": "What elements are in the TR004_8_9 bond atoms?\n（背景知识：TR004_8_9 bond atoms refers to bond_id = 'TR004_8_9';）", "gold_sql": "SELECT DISTINCT T1.element FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id WHERE T2.bond_id = 'TR004_8_9'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-209", "question": "Chlorine is in what type of bond?\n（背景知识：type of bond refers to bond_type; chlorine refers to element = 'cl'）", "gold_sql": "SELECT DISTINCT T1.bond_type FROM bond AS T1 INNER JOIN connected AS T2 ON T1.bond_id = T2.bond_id INNER JOIN atom AS T3 ON T2.atom_id = T3.atom_id WHERE T3.element = 'cl'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-224", "question": "What are the bond IDs that have the same atom ID 2 of TR000_2?\n（背景知识：TR000_2 is the atom id; atom ID 2 refers to atom_id2）", "gold_sql": "SELECT T.bond_id FROM connected AS T WHERE T.atom_id2 = 'TR000_2'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-228", "question": "How much of the hydrogen in molecule TR206 is accounted for? Please provide your answer as a percentage with four decimal places.\n（背景知识：hydrogen refers to element = 'h'; TR206 is the molecule id; percentage = DIVIDE(SUM(element = 'h'), COUNT(atom_id)) as percent where molecule_id = 'TR206'）", "gold_sql": "SELECT ROUND(CAST(COUNT(CASE WHEN T.element = 'h' THEN T.atom_id ELSE NULL END) AS REAL) * 100 / COUNT(T.atom_id),4) FROM atom AS T WHERE T.molecule_id = 'TR206'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-234", "question": "How many bonds which involved atom 12 does molecule TR009 have?\n（背景知识：TR009 is the molecule id;  involved atom 12 refers to atom_id = 'TR009_12' or atom_id2 = 'TR009_12'）", "gold_sql": "SELECT COUNT(T2.bond_id) FROM bond AS T1 INNER JOIN connected AS T2 ON T1.bond_id = T2.bond_id WHERE T1.molecule_id = 'TR009' AND T2.atom_id = T1.molecule_id || '_1' AND T2.atom_id2 = T1.molecule_id || '_2'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-255", "question": "What proportion of single bonds are carcinogenic? Please provide your answer as a percentage with five decimal places.\n（背景知识：single bond refers to bond_type = '-'; label = '+' mean molecules are carcinogenic; proportion = DIVIDE(SUM(label = '+') * 100, COUNT(bond_id)) where bond_type = '-'）", "gold_sql": "SELECT ROUND(CAST(COUNT(CASE WHEN T2.label = '+' THEN T1.bond_id ELSE NULL END) AS REAL) * 100 / COUNT(T1.bond_id),5) FROM bond AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.bond_type = '-'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-283", "question": "Identify whether the chemical compound that contains Calcium is carcinogenic.\n（背景知识：calcium refers to element = 'ca'; label = '+' mean molecules are carcinogenic; label = '-' means molecules are non-carcinogenic;）", "gold_sql": "SELECT T2.label AS flag_carcinogenic FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element = 'ca'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-285", "question": "Name chemical elements that form a bond TR001_10_11.\n（背景知识：element = 'cl' means Chlorine; element = 'c' means Carbon; element = 'h' means Hydrogen; element = 'o' means Oxygen, element = 's' means Sulfur; element = 'n' means Nitrogen, element = 'p' means Phosphorus, element = 'na' means Sodium, element = 'br' means Bromine, element = 'f' means Fluorine; element = 'i' means Iodine; element = 'sn' means Tin; element = 'pb' means Lead; element = 'te' means Tellurium; element = 'ca' means Calcium; TR001_10_11 is the bond id; molecule id refers to SUBSTR(bond_id, 1, 5); atom 1 refers to SUBSTR(bond_id, 7, 2); atom 2 refers to SUBSTR(bond_id, 10, 2)）", "gold_sql": "SELECT T1.element FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id INNER JOIN bond AS T3 ON T2.bond_id = T3.bond_id WHERE T3.bond_id = 'TR001_10_11'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-292", "question": "Identify the atoms belong to the molecule with ID between TR010 to TR050 that contain the element carbon.\n（背景知识：carbon refers to element = 'c'; between TR010 to TR050 refers to substr(molecule_id, 3, 3)>=10 AND substr(molecule_id, 3, 3) <= 50）", "gold_sql": "SELECT T.atom_id FROM atom AS T WHERE T.molecule_id BETWEEN 'TR010' AND 'TR050' AND T.element = 'c'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-313", "question": "How many atoms belong to molecule id TR001?", "gold_sql": "SELECT COUNT(T.atom_id) FROM atom AS T WHERE T.molecule_id = 'TR001'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-318", "question": "What is the molecule id of bond id TR001_1_7?", "gold_sql": "SELECT DISTINCT T1.molecule_id FROM atom AS T1 INNER JOIN connected AS T2 ON T1.atom_id = T2.atom_id WHERE T2.bond_id = 'TR001_1_7'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-326", "question": "Which molecule consisted of Sulphur atom with double bond?\n（背景知识：sulphur refers to element - 's'; double bond refers to bond_type = ' = ';）", "gold_sql": "SELECT DISTINCT T1.molecule_id FROM atom AS T1 INNER JOIN bond AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.element = 's' AND T2.bond_type = '='", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-327", "question": "Which non-carcinogenic molecules consisted more than 5 atoms?\n（背景知识：label = '-' means molecules are non-carcinogenic; molecules consisted more than 5 atoms refers to COUNT(molecule_id) > 5）", "gold_sql": "SELECT T.molecule_id FROM ( SELECT T1.molecule_id, COUNT(T2.atom_id) FROM molecule AS T1 INNER JOIN atom AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.label = '-' GROUP BY T1.molecule_id HAVING COUNT(T2.atom_id) > 5 ) t", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-333", "question": "In the molecule TR008, how many carbons are present?\n（背景知识：carbon refers to element = 'c'）", "gold_sql": "SELECT COUNT(T.atom_id) FROM atom AS T WHERE T.molecule_id = 'TR008' AND T.element = 'c'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-334", "question": "What is the element with the atom ID of TR004_7 in molecule that is not carcinogenic?\n（背景知识：label = '-' means molecules are non-carcinogenic; element = 'cl' means Chlorine; element = 'c' means Carbon; element = 'h' means Hydrogen; element = 'o' means Oxygen, element = 's' means Sulfur; element = 'n' means Nitrogen, element = 'p' means Phosphorus, element = 'na' means Sodium, element = 'br' means Bromine, element = 'f' means Fluorine; element = 'i' means Iodine; element = 'sn' means Tin; element = 'pb' means Lead; element = 'te' means Tellurium; element = 'ca' means Calcium）", "gold_sql": "SELECT T1.element FROM atom AS T1 INNER JOIN molecule AS T2 ON T1.molecule_id = T2.molecule_id WHERE T1.atom_id = 'TR004_7' AND T2.label = '-'", "db": "dev_20240627/dev_databases/toxicology/toxicology.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-350", "question": "State the alternative languages available for card named Annul numbered 29.\n（背景知识：annul refers to name = 'annul'; numbered 29 refers to number = '29';）", "gold_sql": "SELECT T2.language FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T1.uuid = T2.uuid WHERE T1.name = 'Annul' AND T1.number = 29", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-393", "question": "On how many cards designed by John Avon is its foil non-powerful?\n（背景知识：John Avon refer to artist; foil poweful foils refers to cardKingdomId and cardKingdomFoildId is NOT NULL）", "gold_sql": "SELECT COUNT(id) FROM cards WHERE (cardKingdomId IS NULL OR cardKingdomFoilId IS NULL) AND artist = 'John Avon'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-407", "question": "Lists all types of cards in German.\n（背景知识：German refer to language; all types refer to the subtypes, supertypes; subtypes is not null AND supertypes is not null）", "gold_sql": "SELECT T1.subtypes, T1.supertypes FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T1.uuid = T2.uuid WHERE T2.language = 'German' AND T1.subtypes IS NOT NULL AND T1.supertypes IS NOT NULL", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-429", "question": "What is the language and expansion type of set number 206?\n（背景知识：set number 206 refers to id = 206）", "gold_sql": "SELECT T2.language, T1.type FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.id = 206", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-432", "question": "Which Russian set of cards contains the most cards overall?\n（背景知识：Russian refers to language = 'Russian'; contains the most cards overall refers to MAX(baseSetSize)）", "gold_sql": "SELECT T1.id FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.language = 'Russian' GROUP BY T1.baseSetSize ORDER BY T1.baseSetSize DESC LIMIT 1", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-435", "question": "How many card border with black color ? List out the card id.\n（背景知识：border with black color refers to borderColor = 'black'）", "gold_sql": "SELECT id FROM cards WHERE borderColor = 'black' GROUP BY id", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-440", "question": "Which foreign language used by \"A Pedra Fellwar\"?\n（背景知识：\"A Pedra Fellwar\" refers to name = 'A Pedra Fellwar'）", "gold_sql": "SELECT DISTINCT language FROM foreign_data WHERE name = 'A Pedra Fellwar'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-447", "question": "Give the code of sets have expansion commander type?\n（背景知识：code of sets refers to setCode）", "gold_sql": "SELECT T2.setCode FROM sets AS T1 INNER JOIN set_translations AS T2 ON T2.setCode = T1.code WHERE T1.type = 'commander'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-449", "question": "What is the language of the card that has azorius watermark? List out the type of this card.", "gold_sql": "SELECT DISTINCT T2.language, T1.type FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T2.uuid = T1.uuid WHERE T1.watermark = 'azorius'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-451", "question": "How many cards available in paper have a positive starting maximum hand size?\n（背景知识：available in paper refers to availability like '%paper%'; have a positive starting maximum hand size refers to hand = '3'）", "gold_sql": "SELECT SUM(CASE WHEN availability = 'paper' AND hAND = '3' THEN 1 ELSE 0 END) FROM cards", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-457", "question": "Please list the websites where I can purchase the cards that have the promotional type of \"bundle\".\n（背景知识：promotional type of \"bundle\" refers to promoTypes = 'bundle'; websites refers to purchaseUrls）", "gold_sql": "SELECT DISTINCT purchaseUrls FROM cards WHERE promoTypes = 'bundle'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-466", "question": "Among the cards in the set \"Hauptset Zehnte Edition\", how many of them are designed by Adam Rex?\n（背景知识：card set \"Hauptset Zehnte Edition\" refers to translation = 'Hauptset Zehnte Edition'; designed by Adam refers to artist = 'Adam Rex'）", "gold_sql": "SELECT COUNT(T1.id) FROM cards AS T1 INNER JOIN set_translations AS T2 ON T2.setCode = T1.setCode WHERE T2.translation = 'Hauptset Zehnte Edition' AND T1.artist = 'Adam Rex'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-469", "question": "Did the set of cards with \"Angel of Mercy\" appear on Magic: The Gathering Online?\n（背景知识：card set \"Angel of Mercy\" refers to name = 'Angel of Mercy'; appear on Magic: The Gathering Online refers to mtgoCode is NOT NULL and vice versa）", "gold_sql": "SELECT IIF(T2.mtgoCode IS NOT NULL, 'YES', 'NO') FROM cards AS T1 INNER JOIN sets AS T2 ON T2.code = T1.setCode WHERE T1.name = 'Angel of Mercy'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-476", "question": "Please list the name of the cards in the set Coldsnap with the highest converted mana cost.\n（背景知识：card set Coldsnap refers to name = 'Coldsnap'）", "gold_sql": "SELECT T1.name FROM cards AS T1 INNER JOIN sets AS T2 ON T2.code = T1.setCode WHERE T2.name = 'Coldsnap' ORDER BY T1.convertedManaCost DESC LIMIT 1", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-501", "question": "Which card name in the set 'Journey into Nyx Hero's Path' has the highest converted mana cost.\n（背景知识：set 'Journey into Nyx Hero's Path' refers to name = 'Journey into Nyx Hero''s Path'）", "gold_sql": "SELECT T1.name FROM cards AS T1 INNER JOIN sets AS T2 ON T2.code = T1.setCode WHERE T2.name = 'Journey into Nyx Hero''s Path' ORDER BY T1.convertedManaCost DESC LIMIT 1", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-505", "question": "Show the Simplified Chinese translation of the name of the set \"Mirrodin\"?\n（背景知识：Simplified Chinese translation refers to language = 'Chinese Simplified'; name of the set \"Mirrodin\" refers to name = 'Mirrodin'）", "gold_sql": "SELECT translation FROM set_translations WHERE setCode IN ( SELECT code FROM sets WHERE name = 'Mirrodin' ) AND language = 'Chinese Simplified'", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-514", "question": "In duels, what are the top 10 cards with the highest uncoverted mana cost?\n（背景知识：duels refer to format = 'duel'; the highest uncoverted mana cost refers to MAX(manaCost)）", "gold_sql": "SELECT DISTINCT name FROM cards WHERE uuid IN ( SELECT uuid FROM legalities WHERE format = 'duel' ) ORDER BY manaCost DESC LIMIT 0, 10", "db": "dev_20240627/dev_databases/card_games/card_games.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-538", "question": "Please list the titles of the posts owned by the user csgillespie?\n（背景知识：\"csgillespie\" is the DisplayName of user）", "gold_sql": "SELECT T1.Title FROM posts AS T1 INNER JOIN users AS T2 ON T1.OwnerUserId = T2.Id WHERE T2.DisplayName = 'csgillespie'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-541", "question": "What is the display name of the user who is the owner of the most valuable post?\n（背景知识：most valuable post refers to Max(FavoriteCount)）", "gold_sql": "SELECT T2.DisplayName FROM posts AS T1 INNER JOIN users AS T2 ON T1.OwnerUserId = T2.Id ORDER BY T1.FavoriteCount DESC LIMIT 1", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-542", "question": "What is the total number of comments of all the posts owned by csgillespie?\n（背景知识：\"csgillespie\" is the DisplayName of user; total number of comments refers to Sum(CommentCount)）", "gold_sql": "SELECT SUM(T1.CommentCount) FROM posts AS T1 INNER JOIN users AS T2 ON T1.OwnerUserId = T2.Id WHERE T2.DisplayName = 'csgillespie'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-546", "question": "Please list the display names of all the users who owns a post that is well-finished.\n（背景知识：the post that is well-finished refers to ClosedDate IS NOT Null）", "gold_sql": "SELECT T2.DisplayName FROM posts AS T1 INNER JOIN users AS T2 ON T1.OwnerUserId = T2.Id WHERE T1.ClosedDate IS NOT NULL", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-548", "question": "What is the location of the owner of the post \"Eliciting priors from experts\"?\n（背景知识：Owner refers to OwnerUserId; 'Eliciting priors from experts' is the Title of post）", "gold_sql": "SELECT T2.Location FROM posts AS T1 INNER JOIN users AS T2 ON T1.OwnerUserId = T2.Id WHERE T1.Title = 'Eliciting priors from experts'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-552", "question": "Please list the names of the badges obtained by csgillespie.\n（背景知识：\"csgillespie\" is the DisplayName of user）", "gold_sql": "SELECT T1.`Name` FROM badges AS T1 INNER JOIN users AS T2 ON T1.UserId = T2.Id WHERE T2.DisplayName = 'csgillespie'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-563", "question": "User No.3025 gave a comment at 20:29:39 on 2014/4/23 to a post, how many favorite counts did that post get?\n（背景知识：user no. 3025 refers to UserId = '3025'; comment at 20:29:39 on 2014/4/23 refers to CreationDate = '2014/4/23 20:29:39.0'）", "gold_sql": "SELECT T1.FavoriteCount FROM posts AS T1 INNER JOIN comments AS T2 ON T1.Id = T2.PostId WHERE T2.CreationDate = '2014-04-23 20:29:39.0' AND T2.UserId = 3025", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-569", "question": "Give the number of votes for the post about data visualization.\n（背景知识：About data visualization is the Title that contains 'data visualization';）", "gold_sql": "SELECT COUNT(T1.Id) FROM posts AS T1 INNER JOIN votes AS T2 ON T1.Id = T2.PostId WHERE T1.Title LIKE '%data visualization%'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-592", "question": "How many users are awarded with more than 5 badges?\n（背景知识：more than 5 badges refers to Count (Name) > 5; user refers to UserId）", "gold_sql": "SELECT COUNT(UserId) FROM ( SELECT UserId, COUNT(Name) AS num FROM badges GROUP BY UserId ) T WHERE T.num > 5", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-600", "question": "List out all post that are related to post ID 61217 and what is the popularity of this post?\n（背景知识：post related refers to RelatedPostId; popularity refers to ViewCount）", "gold_sql": "SELECT T1.ViewCount FROM posts AS T1 INNER JOIN postLinks AS T2 ON T1.Id = T2.PostId WHERE T2.PostId = 61217", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-644", "question": "Provide the last edit date and last edit user ID for the post \"Detecting a given face in a database of facial images\".\n（背景知识：Title = 'Detecting a given face in a database of facial images';）", "gold_sql": "SELECT LastEditDate, LastEditorUserId FROM posts WHERE Title = 'Detecting a given face in a database of facial images'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-646", "question": "Describe the post title which got positive comments and display names of the users who posted those comments.\n（背景知识：positive comments refer to Score > 60;）", "gold_sql": "SELECT T1.Title, T2.UserDisplayName FROM posts AS T1 INNER JOIN comments AS T2 ON T2.PostId = T2.Id WHERE T1.Score > 60", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-664", "question": "What is the sum of score of the post on 2010-07-19?\n（背景知识：on 2010-07-19 refers to LasActivityDate LIKE '2010-07-19%';）", "gold_sql": "SELECT SUM(Score) FROM posts WHERE LasActivityDate LIKE '2010-07-19%'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-689", "question": "Identify the display name and location of the user, who was the last to edit the post with ID 183.\n（背景知识：last to edit refers to MAX(LastEditDate);）", "gold_sql": "SELECT T2.DisplayName, T2.Location FROM posts AS T1 INNER JOIN users AS T2 ON T1.OwnerUserId = T2.Id WHERE T1.Id = 183 ORDER BY T1.LastEditDate DESC LIMIT 1", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-696", "question": "Count the number of posts with a tag specified as 'careers'.\n（背景知识：tag specified as 'careers' refers to TagName = 'careers';）", "gold_sql": "SELECT COUNT(Id) FROM tags WHERE TagName = 'careers'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-704", "question": "What is the excerpt post ID and wiki post ID of the tag named sample?\n（背景知识：tag named sample refers to TagName = 'sample';）", "gold_sql": "SELECT ExcerptPostId, WikiPostId FROM tags WHERE TagName = 'sample'", "db": "dev_20240627/dev_databases/codebase_community/codebase_community.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-727", "question": "Who is the publisher of Sauron?\n（背景知识：the publisher refers to publisher_name; Sauron refers to superhero_name = 'Sauron'）", "gold_sql": "SELECT T2.publisher_name FROM superhero AS T1 INNER JOIN publisher AS T2 ON T1.publisher_id = T2.id WHERE T1.superhero_name = 'Sauron'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-735", "question": "How many superheroes with blonde hair are there?\n（背景知识：superheroes with blonde hair refers to colour = 'Blond' where hair_colour_id = colour.id）", "gold_sql": "SELECT COUNT(T1.id) FROM superhero AS T1 INNER JOIN colour AS T2 ON T1.hair_colour_id = T2.id WHERE T2.colour = 'Blond'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-740", "question": "How many female superheroes have a strength value of 100?\n（背景知识：female refers to gender = 'Female'; strength value of 100 refers to attribute_name = 'Strength' AND attribute_value = 100）", "gold_sql": "SELECT COUNT(T1.id) FROM superhero AS T1 INNER JOIN hero_attribute AS T2 ON T1.id = T2.hero_id INNER JOIN attribute AS T3 ON T2.attribute_id = T3.id INNER JOIN gender AS T4 ON T1.gender_id = T4.id WHERE T3.attribute_name = 'Strength' AND T2.attribute_value = 100 AND T4.gender = 'Female'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-741", "question": "What is the name of the superhero that has the most powers?\n（背景知识：name of the superhero refers to superhero_name; superhero that has the most powers refers to MAX(COUNT(superhero_name))）", "gold_sql": "SELECT T1.superhero_name FROM superhero AS T1 INNER JOIN hero_power AS T2 ON T1.id = T2.hero_id GROUP BY T1.superhero_name ORDER BY COUNT(T2.hero_id) DESC LIMIT 1", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-747", "question": "What is the total number of superheroes without full name?\n（背景知识：superheroes without full name refers to full_name IS NULL）", "gold_sql": "SELECT COUNT(id) FROM superhero WHERE full_name IS NULL", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-758", "question": "Provide the hair colour of the human superhero who is 185 cm tall.\n（背景知识：185 cm tall refers to height_cm = 185; human superhero refers to race = 'human'; hair colour refers to colour where hair_colour_id = colour.id;）", "gold_sql": "SELECT DISTINCT T3.colour FROM superhero AS T1 INNER JOIN race AS T2 ON T1.race_id = T2.id INNER JOIN colour AS T3 ON T1.hair_colour_id = T3.id WHERE T1.height_cm = 185 AND T2.race = 'Human'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-775", "question": "What is the percentage of blue female superheroes among all female superheroes?\n（背景知识：percentage = MULTIPLY(DIVIDE(SUM(colour = 'Blue' WHERE gender = 'Female'), COUNT(gender = 'Female')), 100); blue refers to the color = 'Blue' WHERE skin_colour_id = colour.id; female refers to gender = 'Female';）", "gold_sql": "SELECT CAST(COUNT(CASE WHEN T3.colour = 'Blue' THEN T1.id ELSE NULL END) AS REAL) * 100 / COUNT(T1.id) FROM superhero AS T1 INNER JOIN gender AS T2 ON T1.gender_id = T2.id INNER JOIN colour AS T3 ON T1.skin_colour_id = T3.id WHERE T2.gender = 'Female'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-777", "question": "What is the gender of Agent 13 hero?\n（背景知识：Agent 13 hero refers to superhero_name = 'Agent 13';）", "gold_sql": "SELECT T2.gender FROM superhero AS T1 INNER JOIN gender AS T2 ON T1.gender_id = T2.id WHERE T1.superhero_name = 'Agent 13'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-778", "question": "Provide superheroes' names who have the adaptation power.\n（背景知识：adaptation power refers to power_name = 'Adaptation';）", "gold_sql": "SELECT T1.superhero_name FROM superhero AS T1 INNER JOIN hero_power AS T2 ON T1.id = T2.hero_id INNER JOIN superpower AS T3 ON T2.power_id = T3.id WHERE T3.power_name = 'Adaptation'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-781", "question": "Provide the heights of the heroes whose eye colours are amber.\n（背景知识：heights of the heroes refers to height_cm; eye colours are amber refers to colour.colour = 'Amber' WHERE eye_colour_id = colour.id;）", "gold_sql": "SELECT T1.height_cm FROM superhero AS T1 INNER JOIN colour AS T2 ON T1.eye_colour_id = T2.id WHERE T2.colour = 'Amber'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-788", "question": "How many percent of female heroes were published by Marvel Comics?\n（背景知识：percent = MULTIPLY(DIVIDE(SUM(gender = 'Female' WHERE publisher_name = 'Marvel Comics'), COUNT(publisher_name = 'Marvel Comics')), 100); female heroes refers to gender = 'Female'; Marvel Comics refers to publisher_name = 'Marvel Comics';）", "gold_sql": "SELECT CAST(COUNT(CASE WHEN T2.publisher_name = 'Marvel Comics' THEN 1 ELSE NULL END) AS REAL) * 100 / COUNT(T1.id) FROM superhero AS T1 INNER JOIN publisher AS T2 ON T1.publisher_id = T2.id INNER JOIN gender AS T3 ON T1.gender_id = T3.id WHERE T3.gender = 'Female'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-810", "question": "What is the race of the superhero with maximum attribute value?\n（背景知识：maximum attribute value refers to MAX(attribute_value);）", "gold_sql": "SELECT T3.race FROM superhero AS T1 INNER JOIN hero_attribute AS T2 ON T1.id = T2.hero_id INNER JOIN race AS T3 ON T1.race_id = T3.id ORDER BY T2.attribute_value DESC LIMIT 1", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-817", "question": "Give the race of the blue-haired male superhero.\n（背景知识：blue-haired refers to colour.colour = 'blue' WHERE hair_colour_id = colour.id; male refers to gender = 'male';）", "gold_sql": "SELECT T3.race FROM superhero AS T1 INNER JOIN colour AS T2 ON T1.hair_colour_id = T2.id INNER JOIN race AS T3 ON T1.race_id = T3.id INNER JOIN gender AS T4 ON T1.gender_id = T4.id WHERE T2.colour = 'Blue' AND T4.gender = 'Male'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-821", "question": "List down Ajax's superpowers.\n（背景知识：Ajax refers to superhero_name = 'Ajax'; superpowers refers to power_name;）", "gold_sql": "SELECT T3.power_name FROM superhero AS T1 INNER JOIN hero_power AS T2 ON T1.id = T2.hero_id INNER JOIN superpower AS T3 ON T2.power_id = T3.id WHERE T1.superhero_name = 'Ajax'", "db": "dev_20240627/dev_databases/superhero/superhero.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-859", "question": "What's Bruno Senna's Q1 result in the qualifying race No. 354?\n（背景知识：race number refers to raceId; Bruno Senna refers to the full name of the driver; Full name of the driver refers to drivers.forename and drivers.surname;）", "gold_sql": "SELECT T1.q1 FROM qualifying AS T1 INNER JOIN drivers AS T2 ON T2.driverId = T1.driverId WHERE T1.raceId = 354 AND T2.forename = 'Bruno' AND T2.surname = 'Senna'", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-864", "question": "For the race happened on 2015/11/29, how many drivers finished the game?\n（背景知识：game and race are synonyms; drivers who finished the race should have record in time;）", "gold_sql": "SELECT COUNT(T2.driverId) FROM races AS T1 INNER JOIN results AS T2 ON T2.raceId = T1.raceId WHERE T1.date = '2015-11-29' AND T2.time IS NOT NULL", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-865", "question": "For all the drivers who finished the game in race No. 592, who is the oldest?\n（背景知识：drivers who finished the race refers to time is not empty (i.e. time IS NOT NULL); race number refers to raceId; date of birth refers to drivers.dob; The larger the birthday value, the younger the person is, and vice versa;）", "gold_sql": "SELECT T1.forename, T1.surname FROM drivers AS T1 INNER JOIN results AS T2 ON T2.driverId = T1.driverId WHERE T2.raceId = 592 AND T2.time IS NOT NULL AND T1.dob IS NOT NULL ORDER BY T1.dob ASC LIMIT 1", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-877", "question": "For all the drivers who finished the game in race No. 872, who is the youngest?\n（背景知识：race number refers to raceId; drivers who finished the race refers to time has value; the youngest is a driver where MAX(dob);）", "gold_sql": "SELECT T1.forename, T1.surname FROM drivers AS T1 INNER JOIN results AS T2 ON T2.driverId = T1.driverId WHERE T2.raceId = 872 AND T2.time IS NOT NULL ORDER BY T1.dob DESC LIMIT 1", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-919", "question": "Which circuit did the 2009 Spanish Grand Prix use?", "gold_sql": "SELECT T1.name FROM circuits AS T1 INNER JOIN races AS T2 ON T2.circuitID = T1.circuitId WHERE T2.year = 2009 AND T2.name = 'Spanish Grand Prix'", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-928", "question": "Which driver ranked the first in the Canadian Grand Prix in 2007? Please give his reference name.\n（背景知识：reference name refers to driverRef; Canadian Grand Prix refers to races.name = 'Canadian Grand Prix';）", "gold_sql": "SELECT T3.forename, T3.surname, T3.driverRef FROM races AS T1 INNER JOIN results AS T2 ON T2.raceId = T1.raceId INNER JOIN drivers AS T3 ON T3.driverId = T2.driverId WHERE T1.name = 'Canadian Grand Prix' AND T2.rank = 1 AND T1.year = 2007", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-939", "question": "How many drivers from the UN participated in the 2008 Australian Grand Prix?\n（背景知识：from the UN refers to nationality = 'British'）", "gold_sql": "SELECT COUNT(*) FROM drivers AS T1 INNER JOIN results AS T2 ON T1.driverId = T2.driverId INNER JOIN races AS T3 ON T3.raceId = T2.raceId WHERE T3.name = 'Australian Grand Prix' AND T1.nationality = 'British' AND T3.year = 2008", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-940", "question": "Among the drivers that finished the race in the 2008 Chinese Grand Prix, how many of them have participated in Formula_1 races?\n（背景知识：COUNT(raceID) > 0 reveals that this driver participated in races; drivers who finished the race refers to time has value.）", "gold_sql": "SELECT COUNT(*) FROM ( SELECT T1.driverId FROM results AS T1 INNER JOIN races AS T2 on T1.raceId = T2.raceId WHERE T2.name = 'Chinese Grand Prix' AND T2.year = 2008 AND T1.time IS NOT NULL GROUP BY T1.driverId HAVING COUNT(T2.raceId) > 0 )", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-946", "question": "Please list the location coordinates of the US circuits.\n（背景知识：location coordinates refers to (lat, lng); the US refers to country = 'USA';）", "gold_sql": "SELECT lat, lng FROM circuits WHERE country = 'USA'", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-958", "question": "Which driver has the fastest lap time? Please give their forenames and surnames.", "gold_sql": "SELECT T2.forename, T2.surname, T1.fastestLapTime FROM results AS T1 INNER JOIN drivers AS T2 on T1.driverId = T2.driverId WHERE T1.fastestLapTime IS NOT NULL ORDER BY T1.fastestLapTime ASC LIMIT 1", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1010", "question": "What is the lap record set by Lewis Hamilton in a Formula_1 race?\n（背景知识：lap recod means the fastest time recorded which refers to time）", "gold_sql": "SELECT T1.time FROM lapTimes AS T1 INNER JOIN drivers AS T2 on T1.driverId = T2.driverId WHERE T2.forename = 'Lewis' AND T2.surname = 'Hamilton'", "db": "dev_20240627/dev_databases/formula_1/formula_1.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1022", "question": "What is the preferred foot when attacking of the player with the lowest potential?\n（背景知识：preferred foot when attacking refers to preferred_foot; lowest potential refers to MIN(potential);）", "gold_sql": "SELECT preferred_foot FROM Player_Attributes WHERE potential IS NOT NULL ORDER BY potential ASC LIMIT 1", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1034", "question": "List the players' api id who had the highest above average overall ratings in 2010.\n（背景知识：highest above average overall ratings refers to MAX(overall_rating); in 2010 refers to substr(date,1,4) = '2010';）", "gold_sql": "SELECT player_api_id FROM Player_Attributes WHERE SUBSTR(`date`, 1, 4) = '2010' ORDER BY overall_rating DESC LIMIT 1", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1043", "question": "What is the short name of the football team Queens Park Rangers?\n（背景知识：short name of the football team refers to team_short_name; Queens Park Rangers refers to team_long_name = 'Queens Park Rangers';）", "gold_sql": "SELECT team_short_name FROM Team WHERE team_long_name = 'Queens Park Rangers'", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1083", "question": "Which player has the strongest overall strength?\n（背景知识：overall strength refers to overall_rating; strongest overall strength refers to MAX(overall_rating);）", "gold_sql": "SELECT t1.player_name FROM Player AS t1 INNER JOIN Player_Attributes AS t2 ON t1.player_api_id = t2.player_api_id ORDER BY t2.overall_rating DESC LIMIT 1", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1093", "question": "What is the average overall rating of the players born before the year 1986?\n（背景知识：average overall rating = DIVIDE(SUM(overall_rating), COUNT(id)); born before the year 1986 refers to strftime('%Y', birthday) < '1986';）", "gold_sql": "SELECT SUM(t2.overall_rating) / COUNT(t1.id) FROM Player AS t1 INNER JOIN Player_Attributes AS t2 ON t1.player_api_id = t2.player_api_id WHERE SUBSTR(t1.birthday, 1, 4) < '1986'", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1098", "question": "What is Ajax's highest chance creation passing score and what is it classified as?\n（背景知识：Ajax's refers to team_long_name = 'Ajax'; chance creation passing score refers to MAX(chanceCreationPassing); classified refer to chanceCreationPassingClass）", "gold_sql": "SELECT t2.chanceCreationPassing, t2.chanceCreationPassingClass FROM Team AS t1 INNER JOIN Team_Attributes AS t2 ON t1.team_api_id = t2.team_api_id WHERE t1.team_long_name = 'Ajax' ORDER BY t2.chanceCreationPassing DESC LIMIT 1", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1103", "question": "What was the overall rating for Aaron Mooy on 2016/2/4?\n（背景知识：Aaron Mooy refers to player_name = 'Aaron Mooy'; on 2016/2/4 refers to date LIKE '2016-02-04%';）", "gold_sql": "SELECT t2.overall_rating FROM Player AS t1 INNER JOIN Player_Attributes AS t2 ON t1.player_api_id = t2.player_api_id WHERE SUBSTR(t2.`date`, 1, 10) = '2016-02-04' AND t1.player_name = 'Aaron Mooy'", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1116", "question": "List down most tallest players' name.\n（背景知识：tallest refers to rank based on the height in descending order; Most tallest players refers to rank = 1）", "gold_sql": "SELECT player_name FROM (SELECT player_name, height, DENSE_RANK() OVER (ORDER BY height DESC) as rank FROM Player) WHERE rank = 1", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1130", "question": "What are the short name of team who played safe while creating chance of passing?\n（背景知识：played safe while creating chance of passing refers to chanceCreationPassingClass = 'Safe'; short name of team refers to team_short_name）", "gold_sql": "SELECT DISTINCT t1.team_short_name FROM Team AS t1 INNER JOIN Team_Attributes AS t2 ON t1.team_api_id = t2.team_api_id WHERE t2.chanceCreationPassingClass = 'Safe'", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1133", "question": "How many football players born after the 1990s have the first name \"Aaron\"?\n（背景知识：first name \"Aaron\" refers to player_name LIKE 'Aaron%'; born after the 1990s refers to birthday > '1990'）", "gold_sql": "SELECT COUNT(id) FROM Player WHERE birthday > '1990' AND player_name LIKE 'Aaron%'", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1140", "question": "What are Alexis Blin's sprint speed, agility, and acceleration scores?\n（背景知识：Alexis Blin's refers to player_name = 'Alexis Blin'）", "gold_sql": "SELECT sprint_speed, agility, acceleration FROM Player_Attributes WHERE player_api_id IN ( SELECT player_api_id FROM Player WHERE player_name = 'Alexis Blin' )", "db": "dev_20240627/dev_databases/european_football_2/european_football_2.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1149", "question": "Are there more in-patient or outpatient who were male? What is the deviation in percentage?\n（背景知识：male refers to SEX = 'M'; in-patient refers to Admission = '+'; outpatient refers to Admission = '-'; percentage = DIVIDE(COUNT(ID) where SEX = 'M' and Admission = '+', COUNT(ID) where SEX  = 'M' and Admission = '-')）", "gold_sql": "SELECT CAST(SUM(CASE WHEN Admission = '+' THEN 1 ELSE 0 END) AS REAL) * 100 / SUM(CASE WHEN Admission = '-' THEN 1 ELSE 0 END) FROM Patient WHERE SEX = 'M'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1161", "question": "For in-patient age 50 and above, what is their average anti-cardiolipin antibody (IgG) concentration?\n（背景知识：in-patient refers to Admission = '+'; age 50 and above refers to SUBTRACT(year(current_timestamp), year(Birthday)) >= '50'; average anti-cardiolipin antibody (IgG) concentration refers to AVG(aCL IgG)）", "gold_sql": "SELECT AVG(T2.`aCL IgG`) FROM Patient AS T1 INNER JOIN Examination AS T2 ON T1.ID = T2.ID WHERE STRFTIME('%Y', CURRENT_TIMESTAMP) - STRFTIME('%Y', T1.Birthday) >= 50 AND T1.Admission = '+'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1182", "question": "For the patient who first came to the hospital on 1991/6/13 who was diagnosed with SJS, what is the total number of his/her Laboratory tests in 1995?\n（背景知识：1991/6/13 refers to `First Date` = '1991-06-13'; 'SJS' refers to Diagnosis; total number of his/her Laboratory tests refers to COUNT(ID); 1995 refers to Date）", "gold_sql": "SELECT COUNT(*) FROM Laboratory WHERE ID = ( SELECT ID FROM Patient WHERE `First Date` = '1991-06-13' AND Diagnosis = 'SJS' ) AND STRFTIME('%Y', Date) = '1995'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1195", "question": "What is the average blood albumin level for female patients with a PLT greater than 400 who have been diagnosed with SLE?\n（背景知识：average blood albumin level refers to AVG(ALB); female refers to SEX = 'F'; PLT greater than 400 refers to PLT > 400; diagnosed with SLE refers to Diagnosis= 'SLE'）", "gold_sql": "SELECT AVG(T2.ALB) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.PLT > 400 AND T1.Diagnosis = 'SLE' AND T1.SEX = 'F'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1197", "question": "When was the medical information on patient number 48473 first documented, and what disease did she have?\n（背景知识：medical information first documented refers to Description; disease refers to diagnosis; patient number refers to id）", "gold_sql": "SELECT `First Date`, Diagnosis FROM Patient WHERE ID = 48473", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1206", "question": "When is the laboratory examination of patient '48473' where his/her AST glutamic oxaloacetic transaminase (GOT) index is above the normal range.\n（背景知识：AST glutamic oxaloacetic transaminase (GOT) index is above the normal range refers to GOT > = 60; when refers to DATE）", "gold_sql": "SELECT Date FROM Laboratory WHERE ID = 48473 AND GOT >= 60", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1209", "question": "Please provide the diagnosis of patients with ALT glutamic pylvic transaminase beyond the normal range by ascending order of their date of birth.\n（背景知识：ALT glutamic pylvic transaminase beyond the normal range refers to GPT > 60; The larger the birthday value, the younger the person is, and vice versa;）", "gold_sql": "SELECT DISTINCT T1.Diagnosis FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.GPT > 60 ORDER BY T1.Birthday ASC", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1220", "question": "Provide all ID, sex and birthday of patients whose urea nitrogen (UN) just within the borderline of passing?\n（背景知识：urea nitrogen (UN) just within the borderline of passing refers to UN = 29;）", "gold_sql": "SELECT DISTINCT T1.ID, T1.SEX, T1.Birthday FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.UN = 29", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1221", "question": "Provide the ID, sex, birthday of all patients diagnosed with 'RA' that are within the UN normal index.\n（背景知识：within the UN normal index refers to UN < 30; Diagnosis = 'RA'）", "gold_sql": "SELECT DISTINCT T1.ID, T1.SEX, T1.Birthday FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.UN < 30 AND T1.Diagnosis = 'RA'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1232", "question": "Provide ID, sex and age of patient who has blood glucose (GLU) not within normal range but with total cholesterol(T-CHO) within normal range.\n（背景知识：age = SUBTRACT(year(current_timestamp), year(Birthday)); blood glucose (GLU) not within normal range refers to GLU > = 180; total cholesterol(T-CHO) within normal range refers to `T-CHO` < 250;）", "gold_sql": "SELECT DISTINCT T1.ID, T1.SEX , STRFTIME('%Y', CURRENT_TIMESTAMP) - STRFTIME('%Y', T1.Birthday) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.GLU >= 180 AND T2.`T-CHO` < 250", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1236", "question": "For all the female patient age 50 and above, who has abnormal red blood cell count. State if they were admitted to hospital.\n（背景知识：female patient refers to Sex = 'F'; age 50 and above = SUBTRACT(year(current_timestamp), year(Birthday)) > = 50; abnormal red blood cell count refers to RBC < = 3.5 or RBC > = 6.0; Admission = '+' means the patient was admitted to the hospital; Admission = '-' means the patient was not admitted to the hospital;）", "gold_sql": "SELECT DISTINCT T1.ID, T1.Admission FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T1.SEX = 'F' AND (T2.RBC <= 3.5 OR T2.RBC >= 6.0) AND STRFTIME('%Y', CURRENT_TIMESTAMP) - STRFTIME('%Y', T1.Birthday) >= 50", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1247", "question": "Among the male patients who have a normal level of white blood cells, how many of them have an abnormal fibrinogen level?\n（背景知识：male patients refers to Sex = 'M'; normal level of white blood cells refers to WBC > 3.5 and WBC <9.0; abnormal fibrinogen level refers to FG < = 150 or FG > = 450; Don't compute repetitive ones.）", "gold_sql": "SELECT COUNT(DISTINCT T1.ID) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.FG <= 150 OR T2.FG >= 450 AND T2.WBC > 3.5 AND T2.WBC < 9.0 AND T1.SEX = 'M'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1266", "question": "Which is the youngest patient with an abnormal anti-ribonuclear protein level? Please list his or her date of birth.\n（背景知识：youngest patient refers to MAX(Birthday); abnormal anti-ribonuclear protein level refers to RNP NOT IN('-', '+-'); date of birth refers to Birthday;）", "gold_sql": "SELECT T1.Birthday FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.RNP != '-' OR '+-' ORDER BY T1.Birthday DESC LIMIT 1", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1285", "question": "When is the latest patient's medical data recorded? This patient should have an abnormal level of lactate dehydrogenase.\n（背景知识：latest patient refers to ID with MAX('First Date'); abnormal level of lactate dehydrogenase refers to LDH > = 500;）", "gold_sql": "SELECT T1.`First Date` FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.LDH >= 500 ORDER BY T1.`First Date` DESC LIMIT 1", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1287", "question": "Among the patients followed at the outpatient clinic, how many of them have a normal level of alkaliphophatase?\n（背景知识：followed at the outpatient clinic refers to Admission = '-'; normal level of alkaliphophatase refers to ALP < 300;）", "gold_sql": "SELECT COUNT(T1.ID) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.ALP < 300 AND T1.Admission = '-'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1300", "question": "What is the disease name of the patient who has the highest level of triglyceride within the normal range?\n（背景知识：disease name referse to Diagnosis; highest level of triglyceride within the normal range refers to MAX(TG < 200);）", "gold_sql": "SELECT T1.Diagnosis FROM Examination AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.TG < 200 ORDER BY T2.TG DESC LIMIT 1", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1301", "question": "Please list the IDs of the patients with no thrombosis and an abnormal level of creatinine phosphokinase.\n（背景知识：no thrombosis refers to Thrombosis = 0 ; abnormal level of creatinine phosphokinase refers to CPK < 250;）", "gold_sql": "SELECT DISTINCT T1.ID FROM Laboratory AS T1 INNER JOIN Examination AS T2 ON T1.ID = T2.ID WHERE T2.Thrombosis = 0 AND T1.CPK < 250", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1309", "question": "Please list a patient's platelet level if it is within the normal range and if he or she is diagnosed with MCTD.\n（背景知识：PLT > 100 and PLT < 400 means platelet level is within the normal range; PLT < 100 and PLT > 400 means platelet level is not within the normal range; diagnosed with MCTD refers to Diagnosis = 'MCTD';）", "gold_sql": "SELECT T2.PLT FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T1.Diagnosis = 'MCTD' AND T2.PLT BETWEEN 100 AND 400", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1310", "question": "For the male patients that have a normal prothrombin time, what is their average prothrombin time?\n（背景知识：male refers to Sex = 'M'; normal prothrombin time refer to PT < 14; average prothrombin time = AVG(PT);）", "gold_sql": "SELECT AVG(T2.PT) FROM Patient AS T1 INNER JOIN Laboratory AS T2 ON T1.ID = T2.ID WHERE T2.PT < 14 AND T1.SEX = 'M'", "db": "dev_20240627/dev_databases/thrombosis_prediction/thrombosis_prediction.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1316", "question": "Please list the phone numbers of the students from the Student_Club that has attended the event \"Women's Soccer\".\n（背景知识：Women's Soccer is an event name; phone numbers refers to phone）", "gold_sql": "SELECT T3.phone FROM event AS T1 INNER JOIN attendance AS T2 ON T1.event_id = T2.link_to_event INNER JOIN member AS T3 ON T2.link_to_member = T3.member_id WHERE T1.event_name = 'Women''s Soccer'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1327", "question": "List the full name of all the members of the Student_Club who attended the \"Laugh Out Loud\" event.\n（背景知识：full name of members refers to first_name, last_name; 'Laugh Out Loud' is an event name;）", "gold_sql": "SELECT T1.first_name, T1.last_name FROM member AS T1 INNER JOIN attendance AS T2 ON T1.member_id = T2.link_to_member INNER JOIN event AS T3 ON T2.link_to_event = T3.event_id WHERE T3.event_name = 'Laugh Out Loud'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1330", "question": "What college offers the major that Tyler Hewitt took?", "gold_sql": "SELECT T2.college FROM member AS T1 INNER JOIN major AS T2 ON T1.link_to_major = T2.major_id WHERE T1.first_name = 'Tyler' AND T1.last_name = 'Hewitt'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1342", "question": "What was the cost for the \"Posters\" on 2019/9/4?\n（背景知识：'Poster' is an event description; on 2019/9/14 refers to event_date = '2019-09-04'）", "gold_sql": "SELECT cost FROM expense WHERE expense_description = 'Posters' AND expense_date = '2019-09-04'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1354", "question": "State the major name for the Vice President of the club.\n（背景知识：'Vice President' is a position of Student Club）", "gold_sql": "SELECT T2.major_name FROM member AS T1 INNER JOIN major AS T2 ON T1.link_to_major = T2.major_id WHERE T1.position = 'Vice President'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1372", "question": "When did the member, Casey Mason, received the income?\n（背景知识：when the income was received refers to date_received）", "gold_sql": "SELECT T2.date_received FROM member AS T1 INNER JOIN income AS T2 ON T1.member_id = T2.link_to_member WHERE T1.first_name = 'Casey' AND T1.last_name = 'Mason'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1385", "question": "Which student was able to generate income more than $40?\n（背景知识：name of students means the full name; full name refers to first_name, last_name; generate income more than $50 refers to income.amount > 40）", "gold_sql": "SELECT T1.first_name, T1.last_name FROM member AS T1 INNER JOIN income AS T2 ON T1.member_id = T2.link_to_member WHERE T2.amount > 40", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1393", "question": "Provide the full name and email address of the Student_Club's Secretary.\n（背景知识：full name refers to first_name, last_name; 'Secretary' is a position of Student Club）", "gold_sql": "SELECT first_name, last_name, email FROM member WHERE position = 'Secretary'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1396", "question": "Provide the number of events attended by Luisa Guidi. What is her major?\n（背景知识：major refers to major_name;）", "gold_sql": "SELECT COUNT(T3.link_to_event), T1.major_name FROM major AS T1 INNER JOIN member AS T2 ON T1.major_id = T2.link_to_major INNER JOIN attendance AS T3 ON T2.member_id = T3.link_to_member WHERE T2.first_name = 'Luisa' AND T2.last_name = 'Guidi'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1399", "question": "Did Maya Mclean attend the 'Women's Soccer' event?\n（背景知识：Maya Mclean is the full name; full name refers to first_name, last_name; 'Women's Soccer' is an event_name）", "gold_sql": "SELECT CASE WHEN T3.event_name = 'Women''s Soccer' THEN 'YES' END AS result FROM member AS T1 INNER JOIN attendance AS T2 ON T1.member_id = T2.link_to_member INNER JOIN event AS T3 ON T2.link_to_event = T3.event_id WHERE T1.first_name = 'Maya' AND T1.last_name = 'Mclean'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1402", "question": "What is the most popular size of t-shirt ordered by the club members?\n（背景知识：most popular size of t-shirt ordered refers to MAX(COUNT(t_shirt_size))）", "gold_sql": "SELECT t_shirt_size FROM member GROUP BY t_shirt_size ORDER BY COUNT(t_shirt_size) DESC LIMIT 1", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1409", "question": "Mention the total expense used on 8/20/2019.\n（背景知识：total expense refers SUM(cost) where expense_date = '2019-08-20'）", "gold_sql": "SELECT SUM(cost) FROM expense WHERE expense_date = '2019-08-20'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1429", "question": "What is the name of the social event that was attended by the vice president of the Student_Club located at 900 E. Washington St.?\n（背景知识：name of social event refers to event_name where type = 'Social'; 'Vice President' is position; located at refers to location）", "gold_sql": "SELECT T2.event_name FROM attendance AS T1 INNER JOIN event AS T2 ON T2.event_id = T1.link_to_event INNER JOIN member AS T3 ON T1.link_to_member = T3.member_id WHERE T3.position = 'Vice President' AND T2.location = '900 E. Washington St.' AND T2.type = 'Social'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1436", "question": "Please provide links to events for members who have paid more than 50 dollar.\n（背景知识：have paid more than 50 dollar refers to cost > 50）", "gold_sql": "SELECT DISTINCT T3.link_to_event FROM expense AS T1 INNER JOIN member AS T2 ON T1.link_to_member = T2.member_id INNER JOIN attendance AS T3 ON T2.member_id = T3.link_to_member WHERE T1.cost > 50", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1437", "question": "Which members who were approved from 1/10/2019 to 11/19/2019? Please identify the member who attended the event and the link to their event.\n（背景知识：approved from 1/10/2019 to 11/19/2019 refers to approved = 'true' and expense_date BETWEEN '2019-01-10' and '2019-11-19'）", "gold_sql": "SELECT DISTINCT T1.link_to_member, T3.link_to_event FROM expense AS T1 INNER JOIN member AS T2 ON T1.link_to_member = T2.member_id INNER JOIN attendance AS T3 ON T2.member_id = T3.link_to_member WHERE date(SUBSTR(T1.expense_date, 1, 10)) BETWEEN '2019-01-10' AND '2019-11-19' AND T1.approved = 'true'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1442", "question": "What is the percentage of the events that went over budget?\n（背景知识：went over budget refers to remaining < 0; percentage = DIVIDE(SUM(remaining < 0), COUNT(event_id)) * 100）", "gold_sql": "SELECT CAST(SUM(CASE WHEN remaining < 0 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(budget_id) FROM budget", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1466", "question": "Write the full name of the club member with the position of 'Secretary' and list which college the club member belongs to.\n（背景知识：full name refers to first_name, last name）", "gold_sql": "SELECT T1.first_name, T1.last_name, college FROM member AS T1 INNER JOIN major AS T2 ON T2.major_id = T1.link_to_major WHERE T1.position = 'Secretary'", "db": "dev_20240627/dev_databases/student_club/student_club.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1470", "question": "How many gas stations in CZE has Premium gas?", "gold_sql": "SELECT COUNT(GasStationID) FROM gasstations WHERE Country = 'CZE' AND Segment = 'Premium'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1476", "question": "What was the difference in gas consumption between CZK-paying customers and EUR-paying customers in 2012?\n（背景知识：Year 2012 can be presented as Between 201201 And 201212; The first 4 strings of the Date values in the yearmonth table can represent year; Difference in Consumption = CZK customers consumption in 2012 - EUR customers consumption in 2012）", "gold_sql": "SELECT SUM(IIF(T1.Currency = 'CZK', T2.Consumption, 0)) - SUM(IIF(T1.Currency = 'EUR', T2.Consumption, 0)) FROM customers AS T1 INNER JOIN yearmonth AS T2 ON T1.CustomerID = T2.CustomerID WHERE SUBSTR(T2.Date, 1, 4) = '2012'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "challenging"]}
{"id": "bird-1493", "question": "In February 2012, what percentage of customers consumed more than 528.3?\n（背景知识：February 2012 refers to '201202' in yearmonth.date; The first 4 strings of the Date values in the yearmonth table can represent year; The 5th and 6th string of the date can refer to month.）", "gold_sql": "SELECT CAST(SUM(IIF(Consumption > 528.3, 1, 0)) AS FLOAT) * 100 / COUNT(CustomerID) FROM yearmonth WHERE Date = '201202'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1494", "question": "What percentage of Slovakian gas stations are premium?\n（背景知识：Percentage of premium gas station = (Total of premium gas station in Slovakia / Total of gas station in Slovakia) * 100%.）", "gold_sql": "SELECT CAST(SUM(IIF(Segment = 'Premium', 1, 0)) AS FLOAT) * 100 / COUNT(GasStationID) FROM gasstations WHERE Country = 'SVK'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1508", "question": "How many transactions taken place in the gas station in the Czech Republic are with a price of over 1000?\n（背景知识：Gas station in the Czech Republic implies that Country = 'CZE'）", "gold_sql": "SELECT COUNT(T1.TransactionID) FROM transactions_1k AS T1 INNER JOIN gasstations AS T2 ON T1.GasStationID = T2.GasStationID WHERE T2.Country = 'CZE' AND T1.Price > 1000", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1516", "question": "How many transactions were paid in CZK in the morning of 2012/8/26?\n（背景知识：'2012/8/26' can be represented by '2012-08-26'; The morning refers to the time before '13:00:00'）", "gold_sql": "SELECT COUNT(T1.TransactionID) FROM transactions_1k AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Date = '2012-08-26' AND T1.Time < '13:00:00' AND T2.Currency = 'CZK'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "moderate"]}
{"id": "bird-1518", "question": "For the deal happened at 2012/8/24 12:42:00, which country was it?\n（背景知识：'2012/8/24 12:42:00' can refer to date = '2012-08-24' AND T1.time = '12:42:00' in the database）", "gold_sql": "SELECT T2.Country FROM transactions_1k AS T1 INNER JOIN gasstations AS T2 ON T1.GasStationID = T2.GasStationID WHERE T1.Date = '2012-08-24' AND T1.Time = '12:42:00'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1525", "question": "What is the percentage of the customers who used EUR in 2012/8/25?\n（背景知识：'2012/8/25' can be represented by '2012-08-25'）", "gold_sql": "SELECT CAST(SUM(IIF(T2.Currency = 'EUR', 1, 0)) AS FLOAT) * 100 / COUNT(T1.CustomerID) FROM transactions_1k AS T1 INNER JOIN customers AS T2 ON T1.CustomerID = T2.CustomerID WHERE T1.Date = '2012-08-25'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "simple"]}
{"id": "bird-1529", "question": "What is the amount spent by customer \"38508\" at the gas stations? How much had the customer spent in January 2012?\n（背景知识：January 2012 refers to the Date value = '201201'）", "gold_sql": "SELECT SUM(T1.Price) , SUM(IIF(T3.Date = '201201', T1.Price, 0)) FROM transactions_1k AS T1 INNER JOIN gasstations AS T2 ON T1.GasStationID = T2.GasStationID INNER JOIN yearmonth AS T3 ON T1.CustomerID = T3.CustomerID WHERE T1.CustomerID = '38508'", "db": "dev_20240627/dev_databases/debit_card_specializing/debit_card_specializing.sqlite", "tags": ["bird", "moderate"]}
