{"id": "olist-0001", "question": "巴拉那州的客户贡献了多少销售额？", "gold_sql": "SELECT SUM(oi.price) FROM order_items oi JOIN orders o ON o.id = oi.order_id JOIN customers c ON c.id = o.customer_id WHERE c.state = 'PR' AND o.status NOT IN ('canceled', 'unavailable')", "tags": ["join", "money", "jargon"]}
{"id": "olist-0002", "question": "2017 年 6 月有多少笔订单？", "gold_sql": "SELECT COUNT(*) FROM orders o WHERE strftime('%Y-%m', o.purchased_at) = '2017-06'", "tags": ["date"]}
{"id": "olist-0003", "question": "按客户所在州，列出平均送达天数最长的 3 个州（中文名）及其平均送达天数", "gold_sql": "SELECT s.name_zh, AVG(julianday(o.delivered_at) - julianday(o.purchased_at)) AS days FROM orders o JOIN customers c ON c.id = o.customer_id JOIN states s ON s.code = c.state WHERE o.delivered_at IS NOT NULL GROUP BY s.name_zh ORDER BY days DESC LIMIT 3", "tags": ["join", "sort", "date", "jargon"]}
{"id": "olist-0004", "question": "寄往里约热内卢州的订单平均送达天数是多少？", "gold_sql": "SELECT AVG(julianday(o.delivered_at) - julianday(o.purchased_at)) FROM orders o JOIN customers c ON c.id = o.customer_id WHERE c.state = 'RJ' AND o.delivered_at IS NOT NULL", "tags": ["join", "date", "jargon"]}
{"id": "olist-0005", "question": "卖家最多的城市是哪个？", "gold_sql": "SELECT city FROM sellers GROUP BY city ORDER BY COUNT(*) DESC LIMIT 1", "tags": ["sort"]}
