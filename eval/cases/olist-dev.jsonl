{"id": "olist-0007", "question": "2017 年 12 月下单的订单里，有多少笔延迟送达？", "gold_sql": "SELECT COUNT(*) FROM orders o WHERE strftime('%Y-%m', o.purchased_at) = '2017-12' AND o.delivered_at IS NOT NULL AND date(o.delivered_at) > date(o.estimated_delivery_at)", "tags": ["date", "jargon"]}
{"id": "olist-0008", "question": "复购客户有多少人？", "gold_sql": "SELECT COUNT(*) FROM (SELECT c.unique_id FROM customers c JOIN orders o ON o.customer_id = c.id GROUP BY c.unique_id HAVING COUNT(DISTINCT o.id) >= 2)", "tags": ["join", "jargon"]}
