# Olist 真实数据评测集 olist-holdout：42 条（seed=42，70/30 切分，gold 逐条执行校验）
# 库：data/olist/olist.sqlite（make olist-db）；口径：eval/knowledge/olist/glossary.jsonl
# ⚠️ holdout 只用于最终复核，调 prompt/检索期间绝不允许跑
{"id": "olist-0097", "question": "米纳斯吉拉斯州的客户贡献了多少销售额？", "gold_sql": "SELECT SUM(oi.price) FROM order_items oi JOIN orders o ON o.id = oi.order_id JOIN customers c ON c.id = o.customer_id WHERE c.state = 'MG' AND o.status NOT IN ('canceled', 'unavailable')", "tags": ["join", "money", "jargon"]}
{"id": "olist-0098", "question": "因为缺货被取消的订单有多少笔？", "gold_sql": "SELECT COUNT(*) FROM orders WHERE status = 'unavailable'", "tags": ["filter"]}
{"id": "olist-0099", "question": "东南部大区有多少位客户？", "gold_sql": "SELECT COUNT(DISTINCT c.unique_id) FROM customers c JOIN states s ON s.code = c.state WHERE s.region_zh = '东南部'", "tags": ["join", "jargon"]}
{"id": "olist-0100", "question": "好评占全部评价的百分之多少？", "gold_sql": "SELECT 100.0 * SUM(score >= 4) / COUNT(*) FROM reviews", "tags": ["jargon"]}
{"id": "olist-0101", "question": "寄往南里奥格兰德州的订单平均送达天数是多少？", "gold_sql": "SELECT AVG(julianday(o.delivered_at) - julianday(o.purchased_at)) FROM orders o JOIN customers c ON c.id = o.customer_id WHERE c.state = 'RS' AND o.delivered_at IS NOT NULL", "tags": ["join", "date", "jargon"]}
{"id": "olist-0102", "question": "2018 年 1 月到 3 月的销售额是多少？", "gold_sql": "SELECT SUM(oi.price) FROM order_items oi JOIN orders o ON o.id = oi.order_id WHERE o.purchased_at >= '2018-01-01' AND o.purchased_at < '2018-04-01' AND o.status NOT IN ('canceled', 'unavailable')", "tags": ["join", "date", "money", "jargon"]}
{"id": "olist-0103", "question": "床品卫浴商品的平均重量是多少克？", "gold_sql": "SELECT AVG(p.weight_g) FROM products p WHERE p.category = 'cama_mesa_banho'", "tags": ["filter"]}
{"id": "olist-0104", "question": "有多少位客户下单买过电脑配件商品？", "gold_sql": "SELECT COUNT(DISTINCT c.unique_id) FROM customers c JOIN orders o ON o.customer_id = c.id JOIN order_items oi ON oi.order_id = o.id JOIN products p ON p.id = oi.product_id WHERE p.category = 'informatica_acessorios'", "tags": ["join", "jargon"]}
{"id": "olist-0105", "question": "分期超过 6 期的信用卡支付有多少笔？", "gold_sql": "SELECT COUNT(*) FROM payments WHERE type = 'credit_card' AND installments > 6", "tags": ["filter"]}
