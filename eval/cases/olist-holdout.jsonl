{"id": "olist-0114", "question": "列出 2018 年 1 月到 6 月每个月的订单数（月份写成 2018-01 这样）", "gold_sql": "SELECT strftime('%Y-%m', purchased_at) AS month, COUNT(*) AS n FROM orders WHERE purchased_at >= '2018-01-01' AND purchased_at < '2018-07-01' GROUP BY month ORDER BY month", "tags": ["date", "sort"]}
